@* @page "/match" *@
@* @using ProcessorLib.Models *@
@* <PageTitle>Resume Match</PageTitle> *@
@* *@
@* <h1>Resume-Job Matcher</h1> *@
@* *@
@* <div class="row"> *@
@*     <div class="col-md-6"> *@
@*         <h3>Resume Text</h3> *@
@*         <textarea @bind="resumeText" rows="15" class="form-control"></textarea> *@
@*     </div> *@
@*      *@
@*     <div class="col-md-6"> *@
@*         <h3>Job Description(s)</h3> *@
@*         <textarea @bind="jdTextsStr" rows="15" class="form-control" placeholder="Enter each JD on a new line"></textarea> *@
@*     </div> *@
@* </div> *@
@* *@
@* <div class="mt-3"> *@
@*     <button @onclick="RunMatch" disabled="@isProcessing" class="btn btn-primary"> *@
@*         @(isProcessing ? "Matching..." : "Run Match") *@
@*     </button> *@
@* </div> *@
@* *@
@* @if (errorMessage != null) *@
@* { *@
@*     <div class="alert alert-danger mt-3">@errorMessage</div> *@
@* } *@
@* *@
@* @if (results != null && results.Any()) *@
@* { *@
@*     <div class="mt-4"> *@
@*         <h2>Results (@results.Count)</h2> *@
@*          *@
@*         @foreach (var result in results) *@
@*         { *@
@*             <div class="card mt-3"> *@
@*                 <div class="card-body"> *@
@*                     <h5 class="card-title">Match Score: @result.Score% - @result.Recommendation</h5> *@
@*                      *@
@*                     <h6>Strong Matches:</h6> *@
@*                     <ul> *@
@*                         @foreach (var skill in result.JdKeywords.Take(5)) *@
@*                         { *@
@*                             <li><span class="badge bg-success">@skill</span></li> *@
@*                         } *@
@*                     </ul> *@
@*                      *@
@*                     <h6>Missing Skills:</h6> *@
@*                     <ul> *@
@*                         @foreach (var skill in result.MissingSkills) *@
@*                         { *@
@*                             <li><span class="badge bg-warning text-dark">@skill</span></li> *@
@*                         } *@
@*                     </ul> *@
@*                 </div> *@
@*             </div> *@
@*         } *@
@*     </div> *@
@* } *@
@* *@
@* @code { *@
@*     private string resumeText = ""; *@
@*     private string jdTextsStr = ""; *@
@*     private bool isProcessing = false; *@
@*     private string? errorMessage; *@
@*     private List<MatchResult>? results; *@
@*      *@
@*     private async Task RunMatch() *@
@*     { *@
@*         isProcessing = true; *@
@*         try *@
@*         { *@
@*             var jdTexts = string.IsNullOrWhiteSpace(jdTextsStr)  *@
@*                 ? new List<string> { "" }  *@
@*                 : jdTextsStr.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList(); *@
@*              *@
@*             var request = new BatchRequest *@
@*             { *@
@*                 ResumeContent = resumeText, *@
@*                 JdContents = jdTexts *@
@*             }; *@
@*              *@
@*             results = await MatchService.MatchResumesAsync(request); *@
@*         } *@
@*         catch (Exception ex) *@
@*         { *@
@*             errorMessage = $"Error: {ex.Message}"; *@
@*         } *@
@*         finally *@
@*         { *@
@*             isProcessing = false; *@
@*         } *@
@*     } *@
@* } *@