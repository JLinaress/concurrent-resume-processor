@page "/match"
@rendermode InteractiveServer
@using ProcessorLib.Models
@using ProcessorWebUI.Contracts
@inject IBatchMatchService MatchService

<PageTitle>Resume Match</PageTitle>

<h1>Resume-Job Matcher</h1>

<div class="row">
    <div class="col-md-6">
        <h3>Resume Text</h3>
        @* Updated to bind instantly on paste/input *@
        <textarea @bind-value="resumeText" @bind-value:event="oninput" rows="15" class="form-control" placeholder="Paste your resume here..."></textarea>
    </div>
    
    <div class="col-md-6">
        <h3>Job Description(s)</h3>
        @* Updated to bind instantly on paste/input *@
        <textarea @bind-value="jdTextsStr" @bind-value:event="oninput" rows="15" class="form-control" placeholder="Enter each JD on a new line..."></textarea>
    </div>
</div>

<div class="mt-3">
    <button @onclick="RunMatch" disabled="@isProcessing" class="btn btn-primary">
        @(isProcessing ? "Matching..." : "Run Match")
    </button>
</div>

@if (errorMessage != null)
{
    <div class="alert alert-danger mt-3">@errorMessage</div>
}

@if (results != null)
{
    @if (results.Any())
    {
        <div class="mt-4">
            <h2>Results (@results.Count match(es))</h2>
            
            @foreach (var result in results)
            {
                <div class="card mt-3">
                    <div class="card-body">
                        <h5 class="card-title">Match Score: @result.Score% - @result.Recommendation</h5>
                        
                        <h6>JD Keywords:</h6>
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            @foreach (var skill in result.JdKeywords.Take(5))
                            {
                                <span class="badge bg-success">@skill</span>
                            }
                        </div>
                        
                        <h6>Missing Skills:</h6>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var skill in result.MissingSkills)
                            {
                                <span class="badge bg-warning text-dark">@skill</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info mt-3">No matching results were generated for the provided text.</div>
    }
}

@code {
    private string resumeText = "";
    private string jdTextsStr = "";
    private bool isProcessing = false;
    private string? errorMessage;
    private List<MatchResult>? results;
    
    private async Task RunMatch()
    {
        if (string.IsNullOrWhiteSpace(resumeText) || string.IsNullOrWhiteSpace(jdTextsStr))
        {
            errorMessage = "Please provide both a resume and at least one job description.";
            return;
        }

        isProcessing = true;
        errorMessage = null;
        results = null;
    
        try
        {
            // 1. Normalize all variations of line endings
            var normalizedResume = resumeText
                .Replace("\r\n", "\n")
                .Replace("\r", "\n");

            // 2. Split into individual lines to completely filter out empty/blank lines
            var resumeLines = normalizedResume.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

            // 3. Rebuild the resume, removing hidden control characters that break JSON parsing
            var cleanLines = resumeLines
                .Select(line => System.Text.RegularExpressions.Regex.Replace(line, @"[\x00-\x1F\x7F]", "")) // Strips hidden ASCII control chars
                .Where(line => !string.IsNullOrWhiteSpace(line));

            // 4. Join back into a clean, single-spaced block of text
            var cleanResume = string.Join("\n", cleanLines).Trim();
            
            // 1. Normalize all variations of line endings
            var normalizedJd = jdTextsStr
                .Replace("\r\n", "\n")
                .Replace("\r", "\n");

            // 2. Split into individual lines to completely filter out empty/blank lines
            var jdLines = normalizedJd.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

            // 3. Rebuild the jd, removing hidden control characters that break JSON parsing
            var cleanJdLines = jdLines
                .Select(line => System.Text.RegularExpressions.Regex.Replace(line, @"[\x00-\x1F\x7F]", "")) // Strips hidden ASCII control chars
                .Where(line => !string.IsNullOrWhiteSpace(line));

            // 4. Join back into a clean, single-spaced block of text
            var cleanJd = string.Join("\n", cleanJdLines).Trim();
            
            var request = new BatchRequest
            {
                ResumeContent = cleanResume,
                JdContents = new List<string>() { cleanJd }
            };
        
            results = await MatchService.MatchBatchAsync(request);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }
}