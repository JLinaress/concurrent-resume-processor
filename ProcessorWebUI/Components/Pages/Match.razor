@page "/match"
@rendermode InteractiveServer
@using ProcessorLib.Models
@using ProcessorWebUI.Contracts
@inject IBatchMatchService MatchService

<PageTitle>Resume Match</PageTitle>


<h1>Resume-Job Matcher</h1>


<div class="row">
   <div class="col-md-6">
       <h3>Resume Text</h3>
       <textarea @bind-value="_resumeText" @bind-value:event="oninput"
                 rows="15" class="form-control"
                 placeholder="Paste your resume here..."></textarea>
   </div>
  
   <div class="col-md-6">
       <h3>Job Description</h3>
       <textarea @bind-value="_jdText" @bind-value:event="oninput"
                 rows="15" class="form-control"
                 placeholder="Enter job description..."></textarea>
   </div>
</div>


<div class="mt-3">
   <button @onclick="RunMatch" disabled="@_isProcessing" class="btn btn-primary">
       @(_isProcessing ? "Matching..." : "Run Match")
   </button>
</div>


@if (_errorMessage != null)
{
   <div class="alert alert-danger mt-3">@_errorMessage</div>
}


@if (_result != null)
{
   <div class="mt-4">
       <h2>Match Score: @_result.Score% - @_result.Recommendation</h2>
      
       <h6>JD Keywords:</h6>
       <div class="d-flex flex-wrap gap-1 mb-2">
           @foreach (var skill in _result.JdKeywords.Take(5))
           {
               <span class="badge bg-success">@skill</span>
           }
       </div>
      
       <h6>Missing Skills:</h6>
       <div class="d-flex flex-wrap gap-1">
           @foreach (var skill in _result.MissingSkills)
           {
               <span class="badge bg-warning text-dark">@skill</span>
           }
       </div>
      
       @if (!string.IsNullOrEmpty(_result.TailoredResumeMarkdown))
       {
           <h6 class="mt-4">Tailored Resume Suggestion:</h6>
           <pre class="bg-light p-3">@_result.TailoredResumeMarkdown</pre>
       }
   </div>
}


@code {
    private string _resumeText = "";
    private string _jdText = "";
    private bool _isProcessing = false;
    private string? _errorMessage;
    private MatchResult? _result;

    private async Task RunMatch()
    {
        if (string.IsNullOrWhiteSpace(_resumeText) || string.IsNullOrWhiteSpace(_jdText))
        {
            _errorMessage = "Please provide both a resume and a job description.";
            return;
        }


        _isProcessing = true;
        _errorMessage = null;
        _result = null;

        try
        {
            // Normalize resume
            var normalizedResume = _resumeText.Replace("\r\n", "\n").Replace("\r", "\n");
            var cleanResume = string.Join("\n",
                normalizedResume.Split('\n', StringSplitOptions.RemoveEmptyEntries)
                    .Select(line => line.Trim())
                    .Select(line => System.Text.RegularExpressions.Regex.Replace(line, @"[\x00-\x1F\x7F]", ""))
                    .Where(line => !string.IsNullOrWhiteSpace(line))
            ).Trim();


            // Normalize JD
            var normalizedJD = _jdText.Replace("\r\n", "\n").Replace("\r", "\n");
            var cleanJd = string.Join("\n",
                normalizedJD.Split('\n', StringSplitOptions.RemoveEmptyEntries)
                    .Select(line => line.Trim())
                    .Select(line => System.Text.RegularExpressions.Regex.Replace(line, @"[\x00-\x1F\x7F]", ""))
                    .Where(line => !string.IsNullOrWhiteSpace(line))
            ).Trim();
           
            var request = new BatchRequest
            {
                ResumeContent = cleanResume,
                JdContent = cleanJd
            };

            _result = await MatchService.MatchAsync(request);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
        }
    }
}